<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.brain-arm.watcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>@BASE@/.venv/bin/python</string>
    <string>@BASE@/watcher.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@BASE@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@PATH@</string>
    <key>HOME</key>
    <string>@HOME@</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <!-- Restarting the watcher must not kill tmux and the running arms. -->
  <key>AbandonProcessGroup</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>@BASE@/logs/watcher.stderr.log</string>
</dict>
</plist>
